<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="projet-jpa">

        <class>fr.imdb.entities.Film</class>
        <class>fr.imdb.entities.Acteur</class>
        <class>fr.imdb.entities.Realisateur</class>
        <class>fr.imdb.entities.Pays</class>
        <class>fr.imdb.entities.Langue</class>
        <class>fr.imdb.entities.LieuDeNaissance</class>
        <class>fr.imdb.entities.LieuDeTournage</class>
        <class>fr.imdb.entities.Role</class>

        <properties>
            <property
                    name="jakarta.persistence.jdbc.url"
                    value="jdbc:mariadb://localhost:3306/cinema?useUnicode=true&amp;characterEncoding=UTF-8"/>

            <property
                    name="jakarta.persistence.jdbc.user"
                    value="root"/>

            <property
                    name="jakarta.persistence.jdbc.password"
                    value=""/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <property
                    name="hibernate.hbm2ddl.auto"
                    value="update"/>
        </properties>
    </persistence-unit>
</persistence>